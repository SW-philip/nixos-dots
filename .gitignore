# Nix build artifacts
result
result-*

# VM disk images
*.qcow2

# Python bytecode / tool caches (uv + ruff, per multiple pkgs/*/pyproject.toml)
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.venv/

# Theme wallpapers (stay on disk, not in git)
themes/**/wallpaper-*.png
themes/**/wallpaper-pit.json
# ...except Kid's: home/kid/niri.nix imports it as a Nix path
# literal (they has no ~/nixos for a runtime lookup like the theme rotation uses).
!themes/Light/kid/wallpaper-kid.png
# ...and the guest account's six (profiles/guest/desktop.nix myConfig.themes): its
# wallpapers come from the store, never ~/nixos.
!themes/Dark/wfp/wallpaper-wfp.png
!themes/Dark/the-work/wallpaper-the-work.png
!themes/Dark/navy-teal/wallpaper-navy-teal.png
!themes/Dark/indigo-rose/wallpaper-indigo-rose.png
!themes/Dark/midnight-rose/wallpaper-midnight-rose.png
!themes/Dark/olive-plum/wallpaper-olive-plum.png

# Generated / profiling outputs (no reason to track these)
boot_profile*
commentlist.txt
errors*.txt
nix-audit.txt
curl_response

# API response memoization cache — regenerated by tools/embed-seeds.py /
# scripts/theme_lib/paths.py, not source data
scripts/api-palette-cache.json

# Private key material (belt-and-suspenders; sops handles actual secrets)
*.key
*.pem
id_rsa
id_ed25519
.env
.env.*
.direnv/


# Personal SSH public keys
desktop_key.pub

# Pytest cache and other nested tool artifacts
**/.pytest_cache/
.superpowers/

# Claude Code agent worktrees
.claude/worktrees/

# de-slop skill scan state (local progress tracking, not repo content)
.de-slop/

.worktrees/

# KOReader sidecar metadata
*.sdr/

# Completed specs/plans/SDD ledgers moved out of context (history keeps the docs)
/claude-archive/
/.claude-shared/
