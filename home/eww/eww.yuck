(defvar reveal false)
(defvar reveal_tv false)
(defvar is_desktop false)
(defvar ledger_hover false)
(defvar ledger_hover_tv false)
(defvar ledger_open false)
(defvar wing_open false)
(defvar fade_on false)

(deflisten vitals  :initial "{}" `bash SCRIPTS/feed.sh 5 0 'bash SCRIPTS/vitals.sh'`)
(deflisten storage :initial "{}" `bash SCRIPTS/feed.sh 61 1 'bash SCRIPTS/storage.sh'`)
(deflisten boot    :initial "{}" `bash SCRIPTS/feed.sh 31 2 'bash SCRIPTS/boot.sh'`)
(deflisten snark   :initial `{"line":""}` `bash SCRIPTS/feed.sh 23 3 'bash SCRIPTS/snark.sh'`)

(deflisten purity :initial "{}" `bash SCRIPTS/feed.sh 19 5 'bash SCRIPTS/purity.sh'`)
(deflisten net    :initial "{}" `bash SCRIPTS/feed.sh 17 7 'bash SCRIPTS/net.sh'`)
(deflisten bt     :initial "{}" `bash SCRIPTS/feed.sh 29 9 'bash SCRIPTS/bt.sh'`)
(deflisten power  :initial "{}" `bash SCRIPTS/feed.sh 37 11 'bash SCRIPTS/power.sh'`)
(deflisten mug    :initial "{}" `bash SCRIPTS/feed.sh 41 13 'bash SCRIPTS/mug.sh'`)
(deflisten myln   :initial "{}" `bash SCRIPTS/feed.sh 43 4 'bash SCRIPTS/myln.sh'`)
(deflisten spark :initial "[]" `bash SCRIPTS/sparkle-picks.sh`)
(deflisten tablet :initial "false" `TABLET_FEED`)
;; true while squeekboard is on screen; the bottom ledger fades out of its way.
(deflisten osk :initial "false" `OSK_FEED`)
(deflisten notifs :initial `{"count":0,"items":[],"groups":[],"query":"","matches":0}` `bash SCRIPTS/notif-feed.sh`)
(defvar notif_tab "notifs")
(defvar nc_open_group "")
(defvar nc_search_text "")
(deflisten launcher_rows :initial "[]" `last=; while :; do cur=$(bash SCRIPTS/launcher-favs.sh); [ "$cur" = "$last" ] || { echo "$cur"; last=$cur; }; sleep 3; done`)
;; Tablet shell (surface, cover detached). tablet-shell swaps waybar for the
;; strip; the sheet drops from under it.
(deflisten tablet_state :initial "{}" `bash SCRIPTS/feed.sh 5 6 'TABLET_STATE'`)
(deflisten controls :initial `{"grids":{},"vol":0,"muted":false,"bright":0,"focus":"","matches":[]}`
  `NOTIF_CONTROLS feed`)
(defpoll clock_text :interval "10s" `date +'%-I:%M %p'`)

;; One coloured letter per pill. `spark` (scripts/sparkle-picks.sh) supplies a
;; regex (k skipped letters + the pick) and a colour per slot `i`. eww's replace()
;; takes its replacement literally, so there are no capture groups: the prefix,
;; the letter and the rest are carved out with search()/replace() instead.
;; Entities are escaped first because :markup parses the text.
(defwidget spk [i text class halign]
  (label :class class :halign halign
         :markup {(arraylength(spark) > i && arraylength(search(replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), spark[i].re)) > 0)
                  ? "${replace(search(replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), spark[i].re)[0], "[A-Za-z]$", "")}<span foreground='${spark[i].c}'>${search(search(replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), spark[i].re)[0], "[A-Za-z]$")[0]}</span>${replace(replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), spark[i].re, "")}"
                  : replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")}))

(defwidget sec [title]
  (label :class "hdr" :halign "start" :text title))

(defwidget subsec [title]
  (label :class "subhdr" :halign "start" :text title))

(defwidget legendary []
  (box :class "section" :orientation "vertical" :space-evenly false :spacing 4
    (sec :title "LEGENDARY")
    (box :class "readout-pill wide" :halign "start"
      (spk :i 0 :class "row" :halign "start" :text "uptime ${boot.uptime_str ?: "?"}  ·  ${boot.kernel ?: "?"}"))
    (box :class "readout-pill wide" :halign "start"
      (spk :i 1 :class "row" :halign "start"
             :text {(boot.rebuild_state ?: "?") == "unknown"
                    ? "rebuild age unknown"
                    : "rebuild ${boot.rebuild_age_h ?: 0}h ago (${boot.rebuild_state ?: "?"})"}))
    (box :class {(boot.gen_drift ?: false) ? "readout-pill wide" : "readout-pill wide inactive"} :halign "start"
      (spk :i 2 :class {(boot.gen_drift ?: false) ? "row readout warn" : "row"} :halign "start"
             :text {(boot.gen_drift ?: false) ? "booted generation ≠ current" : "generation  ·  in sync"}))
    (box :class "readout-pill wide" :halign "start"
      (spk :i 3 :class {(purity.pure ?: true) ? "row" : "row readout warn"} :halign "start"
             :text {(purity.pure ?: true)
                    ? "wayland  ·  pure"
                    : "wayland  ·  ${purity.clients ?: 0} xwayland"}))
    (box :class {(myln.available ?: false) ? "readout-pill wide" : "readout-pill wide inactive"} :halign "start"
      (spk :i 4 :class {(myln.count ?: 0) > 0 ? "row readout warn" : "row"} :halign "start"
             :text {!(myln.available ?: false)
                    ? "myln  ·  n/a"
                    : "myln  ·  ${myln.count ?: 0} errors"}))
    (box :class {jq(boot, ".sleep_drain_pct != null") ? "readout-pill wide" : "readout-pill wide inactive"} :halign "start"
      (spk :i 5 :class "row" :halign "start"
             :text {jq(boot, ".sleep_drain_pct != null")
                    ? "sleep drain  ·  ${boot.sleep_drain_pct}% / ${boot.sleep_hours}h"
                    : "sleep drain  ·  no data"}))
    (box :class {(mug.available ?: false) ? "readout-pill wide" : "readout-pill wide inactive"} :halign "start"
      (spk :i 6 :class "row" :halign "start"
             :text {(mug.available ?: false)
                    ? "mug  ·  ${mug.liquid_state}  ·  ${mug.temp_c}°C → ${mug.target_c}°C  ·  ${mug.battery_pct}%"
                    : "mug  ·  not connected"}))))

(defwidget rare []
  (box :class "section" :orientation "vertical" :space-evenly false :spacing 4
    (sec :title "RARE")
    (subsec :title "resources")
    (box :class "row" :space-evenly true
      (box :class "readout-pill stat-trio"
        (spk :i 7 :class "readout" :halign "start" :text "cpu ${vitals.cpu_pct ?: 0}%"))
      (box :class "readout-pill stat-trio"
        (spk :i 8 :class "readout" :halign "start" :text "mem ${vitals.mem_pct ?: 0}%"))
      (box :class "readout-pill stat-trio"
        (spk :i 9 :class "readout" :halign "start" :text "load avg ${vitals.load1 ?: 0}")))
    (box :class "row" :space-evenly true
      (box :class "readout-pill stat-pair"
        (spk :i 10 :class {(vitals.temp_cpu_c ?: 0) >= 85 ? "readout crit" : "readout"}
               :halign "start"
               :text "cpu temp ${vitals.temp_cpu_c ?: 0}°C"))
      (box :class "readout-pill stat-pair"
        (spk :i 11 :class "readout" :halign "start" :text "peak temp ${vitals.temp_max_c ?: 0}°C")))
    (graph :class "spark" :thickness 2 :time-range "120s" :min 0 :max 100
           :value {vitals.cpu_pct ?: 0} :dynamic true)
    (subsec :title "storage")
    (for m in {storage.mounts ?: "[]"}
      (box :orientation "vertical" :space-evenly false
        (box :class "readout-pill" :space-evenly true
          (label :class "row" :halign "start" :text {m.target})
          (spk :i 12 :class "row" :halign "end"   :text "${m.used_gib}/${m.size_gib} GiB"))
        (progress :class {m.pct >= 90 ? "bar hot" : "bar"} :value {m.pct ?: 0})))
    (box :class "readout-pill" :halign "start"
      (spk :i 13 :class "row" :halign "start"
             :text "generation ${storage.generation ?: "?"} (current) · ${storage.generation_total ?: "?"} kept"))))

;; bt/net/vpn are always-present single rows now -- never appear, disappear,
;; or change row count on a poll. A device connecting/disconnecting or the
;; VPN toggling on/off used to add or remove whole pills here, which is what
;; made the panel visibly grow/shrink on every 20s bt/net poll. Now a poll
;; only ever swaps the text inside a pill that was already there. Before a
;; listener's first poll lands (or if it never does, e.g. bt.sh missing
;; busctl) jq(...,"has(...)") is false and the row shows "loading…" instead
;; of flashing a wrong default or vanishing outright.
(defwidget common []
  (box :class "section" :orientation "vertical" :space-evenly false :spacing 4
    (sec :title "COMMON")
    (box :class "readout-pill wide" :halign "start" :space-evenly true
      (label :class "row" :halign "start" :text "bt")
      (spk :i 14 :class "row" :halign "end"
             :text {!jq(bt, "has(\"count\")") ? "loading…"
                  : (bt.count ?: 0) == 0 ? "no devices"
                  : (bt.count ?: 0) == 1 ? (bt.devices[0].name + (jq(bt.devices[0], ".battery != null") ? "  ·  ${bt.devices[0].battery}%" : ""))
                  : "${bt.count} devices"}))
    (box :class "readout-pill wide" :halign "start" :space-evenly true
      (label :class "row" :halign "start" :text "net")
      (spk :i 15 :class "row" :halign "end"
             :text {!jq(net, "has(\"kind\")") ? "loading…"
                  : (net.kind ?: "none") == "wifi"  ? "${net.ssid} ${net.signal_pct}%"
                  : (net.kind ?: "none") == "wired" ? "wired"
                  : "offline"}))
    (box :class "readout-pill wide" :halign "start" :space-evenly true
      (label :class "row" :halign "start" :text "vpn")
      (spk :i 16 :class "row" :halign "end"
             :text {!jq(net, "has(\"vpn\")") ? "loading…"
                  : (net.vpn ?: false) ? "${net.vpn_name ?: "on"}" : "off"}))
    (box :class "readout-pill wide" :halign "start" :space-evenly true :visible is_desktop
      (label :class "row" :halign "start" :text {(power.present ?: false) ? "battery" : "power"})
      (spk :i 17 :class "row" :halign "end"
             :text {(power.present ?: false) ? "${power.pct}% (${power.state})" : "AC ∞"}))))

;; :height 600 is a floor (GTK size-request semantics, same as :width 410
;; above), measured live against a fully-loaded panel (legendary + rare +
;; all three now-static common rows) with ~8px slack. Normal content sits
;; under it so the panel holds this height exactly; a rare LEGENDARY alert
;; badge (gen_drift/myln/sleep-drain/mug) can still push it taller since
;; those aren't pinned to a fixed row count -- reverify against a live
;; panel if that ever needs fixing too.
(defwidget panel [?dock]
  (box :class "panel ${dock ?: ""}" :orientation "vertical" :space-evenly false :width 410 :height 600
    (label :class "snark" :halign "start" :wrap true :visible {(snark.line ?: "") != ""} :text {snark.line ?: ""})
    (legendary)
    (rare)
    (common)))

;; Tablet-mode tap target: hover doesn't exist on a touchscreen, so with the
;; Type Cover detached this lip, stacked on the inward side of the collapsed
;; strip, toggles the bar/wing. `side` is the screen edge the strip hugs.
(defwidget tap-handle [open var glyph side]
  (button :class "tap-handle tap-${side}"
          :visible tablet :halign "center" :valign "center"
          :onclick "EWW update ${var}=${!open}"
    glyph))

(defwidget ledger-content [?dock]
  (box :class "ledger-bar ${dock ?: ""}${tablet ? " tablet" : ""}" :orientation "horizontal" :space-evenly false :spacing 6
    (button :class "chip" :onclick "EWW update ledger_open=false; LAUNCHER_BIN" :timeout "5s" (spk :i 18 :class "" :halign "center" :text "󰀻 Launcher"))
    (button :class "chip" :onclick "EWW update ledger_open=false; SETTINGS_BIN" :timeout "5s" (spk :i 23 :class "" :halign "center" :text "󰒓 Settings"))
    (button :class "chip" :onclick "EWW update ledger_open=false; UNIREMOTE_TOGGLE" :timeout "5s" :visible {!is_desktop} (spk :i 19 :class "" :halign "center" :text "󰠲 Uniremote"))
    (button :class "chip" :onclick "EWW update ledger_open=false; MOONLIGHT_TOGGLE" :timeout "5s" :visible {!is_desktop} (spk :i 20 :class "" :halign "center" :text "󰊗 Moonlight"))
    (button :class "chip" :onclick "EWW update ledger_open=false; LIX_LOGOUT_TOGGLE" :timeout "5s" (spk :i 21 :class "" :halign "center" :text "󰐻 Logout"))))

;; One window, one eventbox. Two overlapping right-anchored windows can't both
;; receive pointer events, and a window mapped over another via `eww open` never
;; delivers the covered eventbox its leave-notify — so `edge_hover` latched true
;; and the revealer never closed. Here the eventbox wraps the whole [revealer,
;; strip] row: leaving the window fires exactly one :onhoverlost. Collapsed, the
;; row is just the 8px strip, so nothing else on the screen edge is blocked.
;;
;; Two static windows per output (left/right) instead of one reactive window --
;; eww's defwindow :geometry has no defvar/simplexpr support (verified against
;; eww 0.6.0: both :anchor and :width reject a var reference with "Unknown
;; variable" at `eww open` time). Edge choice is "which window is open," not a
;; bound var -- scripts/panel-edge.sh closes one and opens the other. Only one
;; of a pair is ever open at a time.
(defwindow status-left
  :monitor 0
  :geometry (geometry :anchor "left center" :height "85%")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover {tablet ? "true" : "EWW update reveal=true"}
            :onhoverlost {tablet ? "true" : "EWW update reveal=false"}
    (box :orientation "horizontal" :space-evenly false :halign "start" :valign "center"
      ;; Shade: panel at the screen edge, hem (edge) and pull tab on its leading
      ;; side, so all three ride out together instead of the hem staying put.
      (revealer :transition "slideright" :duration "200ms" :reveal {tablet ? wing_open : reveal}
        (panel :dock "left"))
      (box :class {(tablet ? wing_open : reveal) ? "edge hover left" : "edge left"})
      (tap-handle :open wing_open :var "wing_open" :side "left"
                  :glyph {wing_open ? "◀" : "▶"}))))

(defwindow status-right
  :monitor 0
  :geometry (geometry :anchor "right center" :height "85%")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover {tablet ? "true" : "EWW update reveal=true"}
            :onhoverlost {tablet ? "true" : "EWW update reveal=false"}
    (box :orientation "horizontal" :space-evenly false :halign "end" :valign "center"
      (tap-handle :open wing_open :var "wing_open" :side "right"
                  :glyph {wing_open ? "▶" : "◀"})
      (box :class {(tablet ? wing_open : reveal) ? "edge hover" : "edge"})
      (revealer :transition "slideleft" :duration "200ms" :reveal {tablet ? wing_open : reveal}
        (panel)))))

(defwindow status-tv-left
  :monitor 1
  :geometry (geometry :anchor "left center" :height "85%")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover "EWW update reveal_tv=true"
            :onhoverlost "EWW update reveal_tv=false"
    (box :orientation "horizontal" :space-evenly false :halign "start" :valign "center"
      (revealer :transition "slideright" :duration "200ms" :reveal reveal_tv
        (panel :dock "left"))
      (box :class {reveal_tv ? "edge hover left" : "edge left"}))))

(defwindow status-tv-right
  :monitor 1
  :geometry (geometry :anchor "right center" :height "85%")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover "EWW update reveal_tv=true"
            :onhoverlost "EWW update reveal_tv=false"
    (box :orientation "horizontal" :space-evenly false :halign "end" :valign "center"
      (box :class {reveal_tv ? "edge hover" : "edge"})
      (revealer :transition "slideleft" :duration "200ms" :reveal reveal_tv
        (panel)))))

;; One window, one eventbox -- same pattern as `status-left`/`status-right`
;; above (two overlapping windows can't both receive pointer events, and a
;; window mapped over another via `eww open` never delivers the covered
;; eventbox its leave-notify). Hovering the eventbox drives `ledger_hover`
;; (or `ledger_hover_tv`), which both reveals the full bar via the revealer
;; and bumps the collapsed strip's own thickness. Supersedes the earlier
;; two-window strip+popup split and its click-to-toggle
;; (docs/superpowers/specs/2026-09-11-eww-waybar-cohesion-design.md),
;; which existed only to support click-driven open/close -- see
;; docs/superpowers/specs/2026-09-13-ledger-hover-waybar-parity-design.md.
;;
;; Two static windows per output (top/bottom) instead of one reactive window
;; -- see status-left/status-right above for why (eww 0.6.0 defwindow
;; :geometry has no defvar support).
;;
;; No :width "100%" -- that was sized to balance ledger-content's chips
;; against a right-side sqlch chip that's long gone, so the bar was
;; stretching edge-to-edge with a big empty gap on the right for nothing.
;; Anchor "top/bottom center" alone keeps it centered at whatever width the
;; chip row actually needs.
(defwindow ledger-top
  :monitor 0
  :geometry (geometry :anchor "top center")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover {tablet ? "true" : "EWW update ledger_hover=true"}
            :onhoverlost {tablet ? "true" : "EWW update ledger_hover=false"}
    (box :orientation "vertical" :space-evenly false :valign "start"
      (revealer :transition "slidedown" :duration "200ms" :reveal {tablet ? ledger_open : ledger_hover}
        (ledger-content :dock "top"))
      (box :class {(tablet ? ledger_open : ledger_hover) ? "ledger-strip hover top" : "ledger-strip top"}
           :orientation "vertical" :space-evenly false :valign "start")
      ;; Pull tab sits on the shade's hem: it rides down with the panel.
      (tap-handle :open ledger_open :var "ledger_open" :side "top"
                  :glyph {ledger_open ? "▲" : "▼"}))))

(defwindow ledger-bottom
  :monitor 0
  :geometry (geometry :anchor "bottom center")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover {tablet ? "true" : "EWW update ledger_hover=true"}
            :onhoverlost {tablet ? "true" : "EWW update ledger_hover=false"}
    (box :class {osk ? "osk-fade osk-up" : "osk-fade"} :orientation "vertical" :space-evenly false :valign "end"
      ;; Pull tab sits on the shade's hem: it rides up with the panel.
      (tap-handle :open ledger_open :var "ledger_open" :side "bottom"
                  :glyph {ledger_open ? "▼" : "▲"})
      (box :class {(tablet ? ledger_open : ledger_hover) ? "ledger-strip hover" : "ledger-strip"}
           :orientation "vertical" :space-evenly false :valign "end")
      (revealer :transition "slideup" :duration "200ms" :reveal {tablet ? ledger_open : ledger_hover}
        (ledger-content)))))

(defwindow ledger-tv-top
  :monitor 1
  :geometry (geometry :anchor "top center")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover "EWW update ledger_hover_tv=true"
            :onhoverlost "EWW update ledger_hover_tv=false"
    (box :orientation "vertical" :space-evenly false :valign "start"
      (revealer :transition "slidedown" :duration "200ms" :reveal ledger_hover_tv
        (ledger-content :dock "top"))
      (box :class {ledger_hover_tv ? "ledger-strip hover top" : "ledger-strip top"}
           :orientation "vertical" :space-evenly false :valign "start"))))

(defwindow ledger-tv-bottom
  :monitor 1
  :geometry (geometry :anchor "bottom center")
  :stacking "fg" :focusable false :exclusive false
  (eventbox :onhover "EWW update ledger_hover_tv=true"
            :onhoverlost "EWW update ledger_hover_tv=false"
    (box :orientation "vertical" :space-evenly false :valign "end"
      (box :class {ledger_hover_tv ? "ledger-strip hover" : "ledger-strip"}
           :orientation "vertical" :space-evenly false :valign "end")
      (revealer :transition "slideup" :duration "200ms" :reveal ledger_hover_tv
        (ledger-content)))))

;; Tablet-mode launcher: opened by the launcher script (cover detached) instead of
;; fuzzel's list. Tiles come from ~/.local/share/eww/launcher-favs.json in rows of
;; four. A tile closes the window and starts the app through the compositor so eww's
;; button timeout can't kill it; the backdrop closes it too.
(defwindow launcher-tablet
  :monitor 0
  :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :stacking "overlay" :focusable false :exclusive false
  (eventbox :onclick "EWW close launcher-tablet"
    (box :class "launcher-backdrop" :orientation "vertical" :halign "fill" :valign "fill"
      (box :class "launcher-grid" :orientation "vertical" :halign "center" :valign "center"
           :space-evenly false :spacing 22
        (for row in launcher_rows
          (box :orientation "horizontal" :space-evenly true :spacing 22
            (for tile in row
              (button :class "launcher-tile a${tile.accent}" :timeout "2s"
                      :onclick "EWW close launcher-tablet; NIRI_BIN msg action spawn -- sh -c '${tile.cmd}'"
                (box :orientation "vertical" :space-evenly false :spacing 10
                     :halign "center" :valign "center"
                  (label :class "launcher-glyph" :text {tile.icon})
                  (label :class "launcher-label" :text {tile.label}))))))))))

(defwidget ts-slider [glyph value action icon_action]
  (box :class "ts-slider-row" :orientation "horizontal" :space-evenly false :spacing 14
    (button :class "ts-slider-icon" :timeout "3s"
            :onclick {icon_action != "" ? "TABLET_ACT ${icon_action}" : "true"}
      glyph)
    (scale :class "ts-slider" :hexpand true :min 0 :max 100 :value value :timeout "2s"
           :onchange "TABLET_ACT ${action} {}")))

(defwidget ts-toggle [label glyph on action]
  (button :class {on ? "ts-toggle on" : "ts-toggle"} :timeout "5s" :onclick "TABLET_ACT ${action}"
    (box :orientation "vertical" :space-evenly false :spacing 6 :halign "center" :valign "center"
      (label :class "ts-glyph" :text glyph)
      (label :class "ts-label" :text label))))

;; The strip is the tablet-mode bar: exclusive zone, so windows sit below it.
;; A tap anywhere on it toggles the sheet.
(defwindow tablet-strip
  :monitor 0
  :geometry (geometry :anchor "top center" :width "100%" :height "56px")
  :stacking "fg" :focusable false :exclusive true
  (eventbox :onclick "TABLET_ACT sheet"
    (box :class "tablet-strip" :orientation "horizontal" :space-evenly false :spacing 22
      (label :class "ts-clock" :text clock_text)
      (label :class "ts-ws" :text {tablet_state.ws ?: ""})
      (box :hexpand true)
      (label :class "ts-sqlch" :visible {tablet_state.sqlch.playing ?: false}
             :limit-width 26 :text "󰎆 ${tablet_state.sqlch.text ?: ""}")
      (label :class "ts-net"
             :text {(net.kind ?: "none") == "wifi" ? "󰖩" : (net.kind ?: "none") == "wired" ? "󰈀" : "󰖪"})
      (label :class "ts-bat" :text "${tablet_state.bat.pct ?: 0}%${(tablet_state.bat.state ?: "") == "Charging" ? " 󰂄" : ""}"))))

(defwindow tablet-sheet
  :monitor 0
  :geometry (geometry :anchor "top center" :width "100%" :y "56px")
  :stacking "overlay" :focusable false :exclusive false
  (box :class "tablet-sheet" :orientation "vertical" :space-evenly false :spacing 20
    (ts-slider :glyph {(tablet_state.muted ?: false) ? "󰝟" : "󰕾"} :value {tablet_state.vol ?: 0}
               :icon_action "mute" :action "vol")
    (ts-slider :glyph "󰃟" :value {tablet_state.bright ?: 0} :icon_action "" :action "bright")
    (box :class "ts-grid" :orientation "horizontal" :space-evenly true :spacing 14
      (ts-toggle :label "Wi-Fi" :glyph "󰖩" :on {tablet_state.wifi_on ?: false} :action "wifi")
      (ts-toggle :label "Bluetooth" :glyph "󰂯" :on {tablet_state.bt_on ?: false} :action "bt")
      (ts-toggle :label "Keyboard" :glyph "󰌓" :on osk :action "osk")
      (ts-toggle :label "Rotate" :glyph "󰑵" :on {tablet_state.rotate_on ?: false} :action "rotate")
      (ts-toggle :label "Quiet" :glyph "󰂛" :on {tablet_state.dnd_on ?: false} :action "dnd")
      (ts-toggle :label "Desktop" :glyph "󰍹" :on false :action "desktop")
      (ts-toggle :label "Alerts" :glyph "󰂚" :on false :action "notif"))
    (box :class "ts-card" :orientation "horizontal" :space-evenly false :spacing 14
      (label :class "ts-card-main" :hexpand true :halign "start"
             :text "${tablet_state.bat.pct ?: 0}%  ·  ${tablet_state.bat.state ?: ""}  ·  ${tablet_state.bat.eta_text ?: ""}")
      (button :class "ts-pill" :timeout "5s" :onclick "TABLET_ACT profile"
        (label :text {tablet_state.profile ?: "—"})))
    (box :class "ts-card" :orientation "horizontal" :space-evenly false :spacing 14
      (button :class "ts-pill" :timeout "3s" :onclick "TABLET_ACT sqlch prev" "⏮")
      (button :class "ts-pill" :timeout "5s" :onclick "TABLET_ACT sqlch toggle"
        {(tablet_state.sqlch.paused ?: false) ? "▶" : "⏸"})
      (button :class "ts-pill" :timeout "3s" :onclick "TABLET_ACT sqlch next" "⏭")
      (label :class "ts-card-main" :hexpand true :halign "start" :limit-width 40
             :text {(tablet_state.sqlch.playing ?: false) ? (tablet_state.sqlch.text ?: "") : "sqlch  ·  not playing"}))
    (box :class "ts-grid" :orientation "horizontal" :space-evenly true :spacing 14
      (ts-toggle :label "Suspend" :glyph "󰒲" :on false :action "suspend")
      (button :class "ts-toggle" :timeout "5s" :onclick "TABLET_ACT sheet; LIX_LOGOUT_TOGGLE"
        (box :orientation "vertical" :space-evenly false :spacing 6 :halign "center" :valign "center"
          (label :class "ts-glyph" :text "󰐥")
          (label :class "ts-label" :text "Power"))))))

;; Tablet-mode switchover fade (home/niri/tablet-fade.sh), 300ms crossfade both
;; directions. The size is fixed and larger than any logical screen (the largest
;; is 1368 at scale 2.0): a "100%" window is resolved when opened, so it would
;; stop covering the output once the scale changes underneath it. (fade_on is
;; declared with the other vars at the top.)
(defwindow tablet-fade
  :monitor 0
  :geometry (geometry :anchor "center" :width "1400px" :height "1400px")
  :stacking "overlay" :focusable false :exclusive false
  (revealer :transition "crossfade" :duration "300ms" :reveal fade_on
    (box :class "tablet-fade-box" :hexpand true :vexpand true)))

;; notif-center: tabbed replacement for swaync's control-center panel.
(defwidget nc-tab [id label]
  (button :class {notif_tab == id ? "nc-tab on" : "nc-tab"} :timeout "2s"
          :onclick "EWW update notif_tab=${id}"
    label))

(defwidget nc-title [title]
  (box :orientation "horizontal" :space-evenly false :spacing 8
    (box :class "nc-rule-l" :hexpand true :valign "center")
    (label :class "nc-title" :text title)
    (box :class "nc-rule-r" :hexpand true :valign "center")))

(defwidget nc-card [n]
  (box :class "nc-card ${n.urgency}${n.match ? '' : ' dim'}" :orientation "horizontal" :space-evenly false :spacing 10
    (box :orientation "vertical" :space-evenly false :spacing 2 :hexpand true
      (box :orientation "horizontal" :space-evenly false
        (label :class "nc-app" :halign "start" :text {n.app})
        (box :hexpand true)
        (button :class "nc-x" :timeout "2s" :onclick "NOTIF_HISTORY dismiss ${n.id}" "󰅖"))
      (label :class "nc-sum" :halign "start" :xalign 0 :wrap true :text {n.summary})
      (label :class "nc-body" :halign "start" :xalign 0 :wrap true :limit-width 120
             :visible {n.body != ""} :text {n.body}))))

;; A stack of same-app notifications: tap the header to fan it out. A stack that
;; holds a critical item stays open.
(defwidget nc-stack [g]
  (box :orientation "vertical" :space-evenly false :spacing 0
    (eventbox :cursor "pointer" :timeout "2s"
              :onclick "EWW update nc_open_group=${nc_open_group == g.key ? '' : g.key}"
      (box :class "nc-card nc-stack ${g.urgency}${nc_open_group == g.key ? ' open' : ''}${g.match ? '' : ' dim'}" :orientation "horizontal" :space-evenly false :spacing 10
        (box :orientation "vertical" :space-evenly false :spacing 0 :hexpand true
          (box :orientation "horizontal" :space-evenly false :spacing 8
            (label :class "nc-app" :halign "start" :text {g.app})
            (label :class "nc-badge" :text "×${g.count}")
            (box :hexpand true)
            (button :class "nc-x" :timeout "2s" :onclick "NOTIF_HISTORY dismiss ${g.ids}" "󰅖"))
          (revealer :transition "slidedown" :duration "200ms"
                    :reveal {nc_open_group != g.key && g.urgency != 'critical'}
            (box :class "nc-stack-body" :orientation "vertical" :space-evenly false :spacing 2
              (label :class "nc-sum" :halign "start" :xalign 0 :limit-width 40
                     :text {g.items[0].summary})
              (label :class "nc-body" :halign "start" :xalign 0
                     :text "${g.count - 1} more"))))))
    (revealer :transition "slidedown" :duration "220ms"
              :reveal {nc_open_group == g.key || g.urgency == 'critical'}
      (box :class "nc-fan" :orientation "vertical" :space-evenly false :spacing 3
        (for n in {g.items}
          (nc-card :n n))))))

(defwidget nc-group [g]
  (box :orientation "vertical" :space-evenly false
    (box :visible {g.count == 1}
      (nc-card :n {g.items[0]}))
    (box :visible {g.count > 1}
      (nc-stack :g g))))

(defwidget nc-slider [glyph value cmd]
  (box :class "nc-slider-row" :orientation "horizontal" :space-evenly false :spacing 12
    (label :class "nc-slider-glyph" :text glyph)
    (scale :class "nc-slider" :hexpand true :min 0 :max 100 :value value :timeout "2s"
           :onchange "NOTIF_CONTROLS ${cmd} {}")))

(defwidget nc-grid [title rows grid]
  (box :orientation "vertical" :space-evenly false :spacing 6 :visible {arraylength(rows) > 0}
    (nc-title :title title)
    (box :orientation "vertical" :space-evenly false :spacing 1
      (for r in rows
        (button :class "nc-toggle${r.on ? ' on' : ''}${r.match ? '' : ' dim'}" :timeout "8s"
                :onclick "NOTIF_CONTROLS act ${grid} ${r.i}"
          (label :halign "start" :text {r.on ? "◆ ${r.label}" : r.label}))))))

(defwindow notif-center
  :monitor 0
  :geometry (geometry :anchor "top right" :x "8px" :y "8px" :width "360px" :height "92%")
  :stacking "overlay" :focusable "ondemand" :exclusive false
  (box :class "nc-panel" :orientation "vertical" :space-evenly false :spacing 10
    (box :class "nc-tabs" :orientation "horizontal" :space-evenly true :spacing 8
      (nc-tab :id "notifs" :label "Notifications")
      (nc-tab :id "controls" :label "Controls"))
    (overlay
      (box :class "nc-leaf-row" :halign "center"
        (box :class "nc-leaf" :orientation "horizontal" :space-evenly false
          (label :class {notifs.query == "" ? "nc-search-hint" : "nc-search-hint typed"} :text "󰍉  search")
          (input :class "nc-search-input" :value nc_search_text :timeout "2s"
                 :onchange "NOTIF_HISTORY query {}"
                 :onaccept "NOTIF_CONTROLS enter")))
      (box :class "nc-search-actions" :halign "end" :valign "center" :orientation "horizontal" :space-evenly false :spacing 4
        (revealer :transition "slideleft" :duration "200ms" :reveal {notifs.query != ""}
          (button :class "nc-x" :timeout "2s"
                  :onclick "EWW update nc_search_text=' ' && EWW update nc_search_text=" "󰅖"))
        (button :class {osk ? "nc-kbd on" : "nc-kbd"} :visible {!is_desktop} :timeout "2s"
                :onclick "TABLET_ACT osk" "󰌓")))
    (stack :vexpand true :selected {notif_tab == "notifs" ? 0 : 1} :transition "crossfade" :same-size false
      (box :orientation "vertical" :space-evenly false :spacing 0 :vexpand true
        (box :class "nc-count-row" :orientation "horizontal" :space-evenly false
          (label :class "nc-count" :halign "start" :hexpand true :text {notifs.query != "" ? "${notifs.matches} of ${notifs.count}" : "${notifs.count} total"})
          (button :class "nc-clear" :timeout "3s" :onclick "NOTIF_HISTORY clear" "CLEAR ALL"))
        (revealer :transition "slidedown" :duration "200ms"
                  :reveal {arraylength(controls.matches ?: []) > 0}
          (box :class "nc-match-strip" :orientation "vertical" :space-evenly false :spacing 1
            (for r in {controls.matches ?: []}
              (button :class {r.on ? "nc-toggle on" : "nc-toggle"} :timeout "8s"
                      :onclick "NOTIF_CONTROLS act ${r.grid} ${r.i}"
                (label :halign "start" :text {r.on ? "◆ ${r.label}" : r.label})))))
        (scroll :vexpand true :vscroll true :hscroll false
          (box :orientation "vertical" :space-evenly false :spacing 3
            (label :class "nc-empty" :visible {notifs.count == 0} :text "all quiet")
            (for g in {notifs.groups}
              (nc-group :g g)))))
      (scroll :vexpand true :vscroll true :hscroll false
        (box :orientation "vertical" :space-evenly false :spacing 14
          (nc-grid :title "Connectivity" :rows {controls.grids.connectivity ?: []} :grid "connectivity")
          (nc-grid :title "System" :rows {controls.grids.system ?: []} :grid "system")
          (nc-grid :title "Appearance" :rows {controls.grids.appearance ?: []} :grid "appearance"))))
    (box :class "nc-dock" :orientation "vertical" :space-evenly false :spacing 6
      (box :class {controls.focus == 'vol' ? "nc-hit" : ""}
        (nc-slider :glyph {controls.muted ? "󰝟" : "󰕾"} :value {controls.vol} :cmd "vol"))
      (box :class {controls.focus == 'bright' ? "nc-hit" : ""}
        (nc-slider :glyph "󰃟" :value {controls.bright} :cmd "bright")))))
