# Ghostty GTK4 chrome CSS — regenerated by drmis. Styles the non-terminal
# widgetry (context menu, command palette, tab bar, scrollbar, tooltips).
{ p }:
''
  /* Ghostty GTK chrome — regenerated by drmis */
  @define-color gh_surface ${p.PIT_SURFACE};
  @define-color gh_overlay ${p.PIT_OVERLAY};
  @define-color gh_border  ${p.WING};
  @define-color gh_text    ${p.SCORE};
  @define-color gh_dim     ${p.LYRIC};
  @define-color gh_accent  ${p.ROOT};
  @define-color gh_sep     ${p.MUTE};
  @define-color gh_danger  ${p.FORTE};

  popover.menu > contents {
      background-color: @gh_surface;
      border: 1px solid @gh_border;
      border-radius: 8px;
      padding: 4px;
  }
  popover.menu modelbutton {
      border-radius: 6px;
      color: @gh_text;
      padding: 4px 10px;
  }
  popover.menu modelbutton:hover,
  popover.menu modelbutton:focus {
      background-color: alpha(@gh_accent, 0.20);
      color: @gh_text;
  }
  popover.menu modelbutton:disabled { color: @gh_dim; }
  popover.menu modelbutton accelerator,
  popover.menu arrow { color: @gh_dim; }
  popover.menu separator {
      background-color: @gh_sep;
      margin: 4px 8px;
  }

  popover > contents {
      background-color: @gh_surface;
      border: 1px solid @gh_border;
      border-radius: 8px;
      color: @gh_text;
  }
  popover > arrow {
      background-color: @gh_surface;
      border: 1px solid @gh_border;
  }

  listview row, list row {
      color: @gh_text;
      border-radius: 6px;
  }
  listview row:hover, list row:hover,
  listview row:selected, list row:selected {
      background-color: alpha(@gh_accent, 0.20);
      color: @gh_text;
  }

  entry {
      background-color: @gh_overlay;
      color: @gh_text;
      border: 1px solid @gh_border;
      border-radius: 6px;
      caret-color: @gh_accent;
  }
  entry selection {
      background-color: alpha(@gh_accent, 0.35);
      color: @gh_text;
  }

  tabbar, tabbar .box { background-color: @gh_surface; }
  tabbar tab { color: @gh_dim; }
  tabbar tab:checked {
      color: @gh_text;
      background-color: alpha(@gh_accent, 0.15);
  }

  scrollbar slider {
      background-color: alpha(@gh_text, 0.25);
      border-radius: 8px;
  }
  scrollbar slider:hover { background-color: alpha(@gh_text, 0.45); }

  /* libadwaita alert dialog (Close Window?, confirm-close) — Josefin leaf, same as lix-logout: window 24/6, buttons 16/4 */
  dialog-host > dialog.alert sheet {
      background-color: @gh_surface;
      color: @gh_text;
      border: 1px solid @gh_border;
      border-radius: 24px 6px 24px 6px;
      box-shadow: 0 8px 32px rgba(${p.STAFF}, ${p.STAFF_A_DROP});
  }
  dialog.alert .message-area .heading { color: @gh_text; }
  dialog.alert .message-area .body    { color: @gh_dim; }
  dialog.alert .response-area > button {
      background-color: @gh_overlay;
      color: @gh_text;
      border: 1px solid @gh_border;
      border-radius: 16px 4px 16px 4px;
      box-shadow: none;
  }
  dialog.alert .response-area > button:hover,
  dialog.alert .response-area > button:focus {
      background-color: alpha(@gh_accent, 0.20);
  }
  dialog.alert .response-area > button.destructive-action {
      background-color: alpha(@gh_danger, 0.18);
      color: @gh_danger;
      border-color: alpha(@gh_danger, 0.45);
  }
  dialog.alert .response-area > button.destructive-action:hover,
  dialog.alert .response-area > button.destructive-action:focus {
      background-color: alpha(@gh_danger, 0.32);
  }
  floating-sheet > dimming { background-color: rgba(${p.STAFF}, ${p.STAFF_A_OUTER}); }

  tooltip {
      background-color: @gh_surface;
      border: 1px solid @gh_border;
      border-radius: 6px;
  }
  tooltip label { color: @gh_text; }
''
