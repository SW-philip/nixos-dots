# Hyprlock lock screen config — regenerated by drmis. Mirrors the greeter
# (pkgs/greeter/greeter/app.py) widget for widget; change one, change both.
{ p, l, config, lib }:
let
  h    = col: lib.removePrefix "#" col;
  home = config.home.homeDirectory;
  sc   = if config.myConfig.hiDpi then 2 else 1;

  # The greeter's field outline: colors.mix(SCORE, HALL, 0.45), opaque.
  ch      = col: i: lib.fromHexString (builtins.substring i 2 (h col));
  hex2    = n: lib.toLower (lib.fixedWidthString 2 "0" (lib.toHexString n));
  outline = lib.concatMapStrings (i: hex2 ((ch p.SCORE i * 55 + ch p.HALL i * 45 + 50) / 100)) [ 0 2 4 ];

  # hyprlock works in physical pixels with no output scaling, and font_size is
  # Pango *points* at 96 dpi (pt = px × 3/4). The greeter also renders at
  # output scale 1 with --scale ${toString sc} (mark only) and --field-scale 1
  # (everything else), so its CSS px carry over as-is: mark × sc, rest literal.
  pt = px: toString (px * 3 / 4);

  # Greeter band: mark, 14, clock 96, 14, date 32 — a column centred on the
  # screen. Josefin's line box is exactly 1em, so label heights = font px.
  # Offsets are centre-to-centre, y-up (+y raises).
  markPx   = 48 * sc;
  bandH    = markPx + 14 + 96 + 14 + 32;
  markOff  = bandH / 2 - markPx / 2;
  clockMid = markOff - markPx / 2 - 14 - 48;
  dateOff  = clockMid - 48 - 14 - 16;

  # Greeter auth block: valign=center with margin_top = bandH + 40 (scrim
  # padding) + 144 + 24, so its centre sits half that below the screen centre.
  # Block = chip 27, 14, field 34, 14, chip 27, 14, status 12; the field's
  # centre is 27 + 14 + 17 below the block top. The chips and power buttons
  # don't exist on the lock screen, but the field stays where the greeter has it.
  authMid  = 0 - (bandH + 40 + 144 + 24) / 2;
  fieldOff = authMid + 142 / 2 - 58;
in ''
  general {
      hide_cursor        = true
      fractional_scaling = 1
  }

  background {
      path        = ${home}/.local/state/wallpaper-img
      blur_passes = 0
      brightness  = 1.0
      contrast    = 1.0
  }

  # ── mark + clock + date — HALL glow, no band (greeter text/icon-shadow) ──

  # nix mark — flat REST silhouette, drmis-managed (state/nix-mark-img).
  image {
      path          = ${home}/.local/state/nix-mark-img
      size          = ${toString markPx}
      rounding      = 0
      border_size   = 0
      shadow_passes = 2
      shadow_size   = 5
      shadow_color  = rgba(${h p.HALL}f2)
      position      = 0, ${toString markOff}
      halign        = center
      valign        = center
  }

  # Clock — greeter clock_text(): 12h unless ~/.cache/quantum_clock/24h is "1".
  label {
      text          = cmd[update:1000] [ "$(cat ~/.cache/quantum_clock/24h 2>/dev/null)" = 1 ] && date +%H:%M || date +"%-I:%M %p"
      color         = rgba(${h p.SCORE}ff)
      font_size     = ${pt 96}
      font_family   = Josefin Sans SemiBold
      shadow_passes = 3
      shadow_size   = 12
      shadow_color  = rgba(${h p.HALL}e6)
      shadow_boost  = 1.4
      position      = 0, ${toString clockMid}
      halign        = center
      valign        = center
  }

  # Date
  label {
      text          = cmd[update:60000] date +"%A, %d %B"
      color         = rgba(${h p.REST}ff)
      font_size     = ${pt 32}
      font_family   = Josefin Sans
      shadow_passes = 2
      shadow_size   = 6
      shadow_color  = rgba(${h p.HALL}f2)
      position      = 0, ${toString dateOff}
      halign        = center
      valign        = center
  }

  # ── password field — greeter .field: 240 + 2×13 pad + 2 border wide ──────

  input-field {
      size              = 268, 34
      outline_thickness = 1
      dots_size         = 0.2
      dots_spacing      = 0.4
      dots_center       = true

      outer_color       = rgba(${outline}ff)
      inner_color       = rgba(${h p.STAGE}ff)
      font_color        = rgba(${h p.SCORE}ff)
      font_family       = Josefin Sans
      fade_on_empty     = false
      rounding          = 6
      check_color       = rgba(${h p.PIANO}ff)
      fail_color        = rgba(${h p.FORTE}ff)
      fail_text         = @@SNARK@@
      placeholder_text  =
      hide_input        = false
      shadow_passes     = 1
      shadow_size       = 4
      shadow_color      = rgba(${h p.HALL}a6)
      position          = 0, ${toString fieldOff}
      halign            = center
      valign            = center
  }
''
