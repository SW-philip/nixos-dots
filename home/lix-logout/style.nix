# lix-logout style CSS — regenerated by drmis. No hardcoded hex.
# Session menu: one flat panel (WING shell, 1px thread border, the house hard
# offset). Header (nix mark + host · user) over a hairline, then four plain
# rows: ink on WING at rest, DIM + a thin SCORE bar on the left edge on
# hover/focus. FORTE (warning) appears only on an armed Reboot/Shutdown row.
# The nix mark (state/nix-mark-img) is the same drmis-tinted image the
# greeter and the lock screen carry.
# Leaf shape (Josefin J/S/G/K terminals): big round corners on one diagonal, small sharp
# ones on the other: window 24/6, rows 16/4.
# See home/niri/swaync/style.nix.
{ p, l }:
''
  * {
      background-image: none;
      text-shadow: none;
      font-family: "Josefin Sans", "JetBrainsMono Nerd Font", monospace;
  }

  window {
      background-color: ${p.WING};
      border: 1px solid ${p.SCORE}8c;
      border-radius: 24px 6px 24px 6px;
      box-shadow: 3px 4px 0 0 rgba(${p.STAFF}, ${p.STAFF_A_DROP});
  }

  .lix-logout-panel {
      padding: 6px;
  }

  .lix-logout-header {
      padding: 10px 12px;
  }

  .lix-logout-host {
      color: ${p.SCORE}99;
      font-size: 12px;
  }

  separator {
      background-color: ${p.SCORE}26;
      min-height: 1px;
      margin: 0 8px 6px 8px;
  }

  button.lix-logout-row {
      color: ${p.SCORE};
      background-color: transparent;
      border: none;
      border-radius: 16px 4px 16px 4px;
      padding: 9px 12px;
      outline-style: none;
      box-shadow: none;
  }

  button.lix-logout-row:hover,
  button.lix-logout-row:focus {
      background-color: ${p.DIM};
      box-shadow: inset 3px 0 0 0 ${p.SCORE};
  }

  button.lix-logout-row.armed,
  button.lix-logout-row.armed:hover,
  button.lix-logout-row.armed:focus {
      background-color: ${p.FORTE};
      color: ${p.HALL};
      box-shadow: none;
  }

  .lix-logout-icon {
      font-size: 18px;
      min-width: 22px;
  }

  .lix-logout-label {
      font-size: 14px;
  }

  .lix-logout-hint {
      color: ${p.SCORE}99;
      font-size: 12px;
      font-weight: 700;
  }

  button.lix-logout-row.armed .lix-logout-hint {
      color: ${p.HALL};
  }
''
