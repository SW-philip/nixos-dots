{ config, ... }:
{
  imports = [ ../../modules/myln/module.nix ];

  myln = {
    # Vulkan llama-cpp is binary-cached; the old CUDA build recompiled on every bump.
    enable = true;
    user = "prepko";
    vulkanSupport = true;
    gpuLayers   = 999;

    modelPath = "/var/lib/myln/models/Qwen3-4B-Q4_K_M.gguf";
    modelUrl  = "https://huggingface.co/Qwen/Qwen3-4B-GGUF/resolve/main/Qwen3-4B-Q4_K_M.gguf";

    embeddingModelPath = "/var/lib/myln/models/nomic-embed-text-v1.5.Q4_K_M.gguf";
    embeddingModelUrl  = "https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.Q4_K_M.gguf";
    embeddingCtxSize   = 8192;
    embeddingBatchSize = 8192;

    # /etc/nixos covers the whole flake — desktop + surface configs all in one.
    # system-map.md (generated by `myln-treemap`) teaches it the general filesystem
    # layout outside the flake — rerun myln-treemap + embed after layout changes.
    docPaths = [
      "/home/${config.myConfig.user}/nixos"
      "/var/lib/myln/system-map.md"
    ];

    treeRoots = [
      "/home/${config.myConfig.user}"
      "/srv"
      "/var/lib"
      "/mnt"
    ];

    topK        = 5;
    maxTokens   = 256;
    ctxSize     = 4096;
    temperature = "0.2";

    diagnosisMaxErrors  = 20;
    diagnosisMaxTokens  = 1500;
    diagnoseTime        = "00:00";
    diagnoseTimeout     = 120;

    logIgnoreUnits = [
      "dbus-broker-launch"   # startup bus races, never actionable
      "bluetoothd"           # expected errors when no device paired
      "liblixmain-tests"    # lix unit tests testing their own crash handler — intentional throws
    ];

    logIgnorePatterns = [
      "^\\+"                 # stack trace continuation lines leaking through awk field parse
      "^ddcutil: .*DDCRC_RETRIES"                      # routine DDC retries on DP monitors
      "^sudo: pam_unix\\(sudo:auth\\): (auth could not identify password|conversation failed)"  # a sudo prompt timing out
      "^sudo: .* : (a password is required|1 incorrect password attempt)"  # one typo or a timed-out prompt; 2+ still surface
      "^systemd: Failed to start Refresh NetworkManager WiFi scan cache"  # wired desktop, nothing to scan
      "^[A-Za-z0-9_-]+: [0-9]+K( \\.{1,10})+"  # wget progress bars on stderr from one-off containers
    ];

    knownIssues = [
      {
        pattern = "^kernel: Bluetooth: hci0: (command 0x[0-9a-f]+ tx timeout|Opcode 0x[0-9a-f]+ failed: -110|start background scanning failed: -110)";
        verdict = "watch";
        note = "Bluetooth controller command timed out (-110 is ETIMEDOUT). Transient on its own; if a device stops pairing or connecting, run `sudo systemctl restart bluetooth`, then power-cycle the adapter.";
      }
      {
        pattern = "^kernel: Memory cgroup out of memory: Killed process";
        verdict = "watch";
        note = "A cgroup hit its own memory limit and the kernel killed one process, not the whole system. Only worth chasing if it keeps hitting the same app; `journalctl -k | grep -i oom` names the cgroup.";
      }
      {
        pattern = "^nixos: switching to system configuration .* failed \\(status [0-9]+\\)";
        verdict = "action";
        note = "A rebuild's activation failed. Run `systemctl --failed`, then `journalctl -b -u <that unit>`. Usually a unit that would not start, not a bad build.";
        clearedBy = "^nixos: finished switching to system configuration";
      }
      {
        pattern = "^pipewire: pw\\.node: \\(bluez_output\\..*running -> error";
        verdict = "benign";
        note = "A Bluetooth audio device dropped while streaming (powered off or out of range). Expected.";
      }
      {
        pattern = "^sudo: .* ([2-9]|[1-9][0-9]+) incorrect password attempts?";
        verdict = "action";
        note = "Repeated failed sudo attempts. Confirm it was you.";
      }
      {
        pattern = "SGX disabled or unsupported by BIOS";
        verdict = "benign";
        note = "This CPU has no SGX; not configurable.";
      }
      {
        pattern = "watchdog0: watchdog did not stop";
        verdict = "benign";
        note = "Harmless on shutdown or reboot.";
      }
      {
        pattern = "^sshd-session: mm_reap: child terminated by signal 15";
        verdict = "benign";
        note = "Normal SSH disconnect.";
      }
      {
        pattern = "^systemd-tty-ask-password-agent: Failed to send";
        verdict = "benign";
        note = "No TTY password agent at headless boot stages.";
      }
      {
        pattern = "^greetd: gkr-pam: unable to locate daemon control file";
        verdict = "benign";
        note = "greetd does not run gnome-keyring.";
      }
    ];

    diagnoseSystemContext = ''
      Hardware: i5-9600K, GTX 1660, dual DP monitors. NixOS 26.11 with niri compositor.
      Disambiguation: any retrieved Nix config containing 'temperature = "..."' refers to an LLM
      inference sampling parameter (range 0.0–1.0), NOT a hardware temperature threshold.
      The screen locker is hyprlock; core dumps from it are recurring and low-priority unless daily.
    '';
  };
}
