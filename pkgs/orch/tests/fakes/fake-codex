#!/usr/bin/env python3
import json, os, sys, time

VERDICT = {"verdict": "changes", "summary": "nope",
           "findings": [{"severity": "major", "text": "fix it"}]}
stdin = sys.stdin.read()
argv = sys.argv[1:]
with open(os.environ["FAKE_RECORD"], "w") as f:
    json.dump({"argv": argv, "stdin": stdin, "pid": os.getpid(),
               "env": dict(os.environ)}, f)
mode = os.environ.get("FAKE_MODE", "plain")
if mode == "hang":
    time.sleep(60)
out = argv[argv.index("-o") + 1]
with open(out, "w") as f:
    f.write("```json\n" + json.dumps(VERDICT) + "\n```" if mode == "review" else "implemented")
print("codex stdout")
